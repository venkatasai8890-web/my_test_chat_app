# Copy this file to .env and fill in real values. Never commit .env.

# Required secrets — use your own keys. Do NOT copy these from
# ~/Pinecone_RAG_homework/.env; that project's key values are not meant to be
# reused here, only its (already-proven) code approach.
PINECONE_API_KEY=
OPENAI_API_KEY=

# Shared secret this service checks on every request (X-RAG-Service-Token
# header). Must match RAG_SERVICE_TOKEN in my_test_chat_app/.env.local.
RAG_SERVICE_TOKEN=

# Non-secret config. A separate index from Pinecone_RAG_homework's
# "apple-10k-rag" — created automatically on first run if it doesn't exist.
PINECONE_INDEX_NAME=chat-app-rag
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Optional: Qdrant Cloud, used only when the app selects Qdrant as the vector
# database. Leave blank to run with Pinecone only. Use a dedicated collection —
# the service creates it automatically and refuses to write to an existing
# collection it did not create.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=chat-app-rag
